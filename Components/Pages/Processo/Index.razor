@page "/processos"
@using AppWebClistenis.Model
@using AppWebClistenis.DAO
@inject ProcessoDAO ProcessoDAO

<PageTitle> Processos - Sitema de Controle de Processos</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>Consulta de Processos</h2>
    </div>
</div>
<div class="custom-table-card">
    <div  class="table-responsive">

        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Número</th>
                    <th>Interessado</th>
                    <th>Assunto</th>
                    <th>Situação</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>1</td>
                    <td>RO - 12354</td>
                    <td>Clistenis Rafael</td>
                    <td>Solicitação de Ligação de Água</td>
                    <td>Aberto</td>
                    <td></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>


@code {
    private List<Processo> processos = new();

    protected override void OnInitialized()
    {
        // Chama o DAO para buscar os dados no banco
        processos = ProcessoDAO.Listar();
     } 
}